rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      let userDoc = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(userDoc) && (get(userDoc).data.role == 'admin' || get(userDoc).data.role == 'master_admin');
    }
    
    function iSMasterAdmin() {
      let userDoc = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(userDoc) && get(userDoc).data.role == 'master_admin';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Users ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn(); 
      allow update: if isSignedIn(); 
      allow delete: if isSignedIn();
    }

    // --- Staff ---
    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // --- Students ---
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // --- Classes ---
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // --- Attendance ---
    match /attendance/{date} {
      allow read: if isSignedIn();
      match /records/{studentId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn(); // Teachers can mark attendance
      }
    }

    // --- Staff Attendance ---
    match /staffAttendance/{date} {
      allow read: if isSignedIn();
      match /records/{staffId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (request.auth.uid == staffId || isAdmin());
      }
    }

    // --- Settings ---
    match /settings/global {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
